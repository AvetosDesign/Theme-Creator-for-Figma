{
  "name": "wp-figma-gen",
  "version": "0.3.1",
  "private": true,
  "license": "GPL-3.0-only",
  "description": "Stage 2 of the Figma → WordPress pipeline: generates a WordPress block theme or pattern JSON files from a Design Bundle. No Figma access required.",
  "type": "module",
  "bin": {
    "wp-figma-gen": "./dist/index.js"
  },
  "files": [
    "dist/**"
  ],
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "build:vendor-zip": "node scripts/build-vendor-zip.mjs"
  },
  "dependencies": {
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsup": "^8.5.1",
    "tsx": "^4.19.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
